# Virtual env
.venv/

# Secrets — never commit
.env
credentials.json
token.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Pytest / IDE / OS
.pytest_cache/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Experiment artefacts (large + regenerable from the runner + analyze chain)
outputs/
data/*
# ...but the golden evaluation set is the OPPOSITE of regenerable: it is the
# fixed, hand-annotated reference the quality gate scores against, and it has to
# be version-controlled or "reproducible and auditable" is just a claim.
# data/golden/manifest.json fingerprints every file with SHA-256 so a report
# cannot silently change its own evaluation set.
!data/golden/

# Build artefacts (xlsx, html, png — regenerable from build_* scripts)
Results/

# Client-confidential input data — copy briefs.example.yml → briefs.yml locally
briefs.yml

# promptfoo cross-validation: generated test data + raw results contain client briefs
promptfoo-real/tests.yaml
promptfoo-real/tests3.yaml
promptfoo-real/results/

# Browser suite: engines, node modules, traces and reports are all regenerable.
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# Giskard scan reports (scripts/scan_giskard.py writes to lowercase results/)
results/

# Local-only notes and planning documents
*.pdf
promptfoo-demo/怎么跑_步骤.md
.claude/
